{
  "name": "@talaagent/proto-domain",
  "version": "0.1.0",
  "description": "Runtime for protoc-gen-domain: protobuf <-> Temporal converters, codec types and a validated ConnectRPC client",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talaagent/proto-domain.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/talaagent/proto-domain#readme",
  "keywords": [
    "protobuf",
    "protobuf-es",
    "temporal",
    "connectrpc",
    "protovalidate",
    "codegen"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "default": "./dist/connect.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.0",
    "temporal-spec": "^1.0.1"
  },
  "peerDependencies": {
    "@bufbuild/protovalidate": "^1.0.0",
    "@connectrpc/connect": "^2.0.0",
    "temporal-polyfill": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protovalidate": {
      "optional": true
    },
    "@connectrpc/connect": {
      "optional": true
    },
    "temporal-polyfill": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/protovalidate": "^1.3.0",
    "@connectrpc/connect": "^2.3.0",
    "temporal-polyfill": "^1.0.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
